{
  "name": "desklog-monorepo",
  "version": "1.0.1",
  "private": true,
  "description": "Universal desktop logging & diagnostics engine for Electron, Tauri, and Node.js. Features cascade file rotation, strict disk bounding, sensitive data masking, multi-user isolation, and one-click diagnostic ZIP packaging.",
  "author": {
    "name": "Novra Tools",
    "url": "https://x.com/novratools"
  },
  "homepage": "https://x.com/novratools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Novra-tools/NovraLogger.git"
  },
  "bugs": {
    "url": "https://github.com/Novra-tools/NovraLogger/issues"
  },
  "keywords": [
    "desklog",
    "desktop-logger",
    "desktop-log",
    "desktop-logging",
    "electron-log",
    "electron-logger",
    "electron-logging",
    "electron-plugin",
    "tauri-log",
    "tauri-logger",
    "tauri-plugin-log",
    "cross-platform-logger",
    "log-rotation",
    "log-rotator",
    "rotating-file",
    "cascade-rotation",
    "log-cleaner",
    "log-cleanup",
    "log-packer",
    "log-zip",
    "log-sanitizer",
    "data-masking",
    "sensitive-data-masking",
    "token-masking",
    "diagnostic-logs",
    "crash-reporter",
    "crash-dump",
    "feedback-logs",
    "nodejs-logger",
    "file-logger",
    "zero-dependency",
    "pure-js-logger",
    "electron-log-alternative"
  ],
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "build": "pnpm --filter desklog build",
    "test": "pnpm --filter desklog test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "demo": "pnpm --filter electron-demo start",
    "clean": "pnpm -r --parallel run clean",
    "release:check": "node scripts/verify-release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release": "node scripts/release.mjs"
  }
}
